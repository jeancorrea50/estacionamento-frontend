{
  "name": "gts-front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript http://108.174.145.123:5000/swagger/v1/swagger.json -o src/app/core/api/generated/api-types.ts",
    "generate:api:deploy": "openapi-typescript http://108.174.145.123:5000/swagger/v1/swagger.json -o src/app/core/api/generated/api-types.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/material": "^21.2.10",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@primeuix/themes": "^2.0.3",
    "@swimlane/ngx-charts": "^20.5.0",
    "apexcharts": "^5.11.0",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "ng-apexcharts": "^2.4.0",
    "ng2-charts": "^8.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.12",
    "@playwright/test": "^1.58.2",
    "jsdom": "^27.1.0",
    "openapi-typescript": "^7.4.2",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
