{
  "/estac/worker": {
    "target": "http://localhost:8081",
    "secure": false,
    "changeOrigin": true,
    "ws": true,
    "logLevel": "warn"
  },
  "/estac/notification": {
    "target": "http://localhost:8083",
    "secure": false,
    "changeOrigin": true,
    "ws": true,
    "logLevel": "warn"
  },
  "/estac": {
    "target": "https://localhost:44317",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "warn"
  },
  "/api": {
    "target": "https://localhost:44317",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "warn",
    "pathRewrite": {
      "^/api": "/estac/api"
    }
  },
  "/viacep": {
    "target": "https://viacep.com.br",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": { "^/viacep": "" }
  }
}
